<?xml version="1.0" encoding="UTF-8"?>
<component-configuration
    xmlns="http://tis.co.jp/nablarch/component-configuration"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://tis.co.jp/nablarch/component-configuration https://nablarch.github.io/schema/component-configuration.xsd">

  <!-- プロダクション用の設定読み込み -->
  <import file="messaging-sync-send-component-configuration.xml"/>

  <import file="nablarch/core/date_test.xml"/>

  <!-- メッセージングプロバイダ定義 -->
  <component name="defaultMessagingProvider"
             class="nablarch.test.core.messaging.RequestTestingMessagingProvider" />

  <!-- テスティングフレームワークの設定 -->
  <import file="nablarch/test/test-data.xml"/>

  <!-- 汎用のDB設定 -->
  <component name="dbInfo" class="nablarch.test.core.db.GenericJdbcDbInfo">
    <property name="dataSource" ref="dataSource"/>
    <property name="schema" value="${nablarch.db.schema}"/>
  </component>

  <!-- YAMLテストデータ用インタープリタ（QuotationTrimmerを除く） -->
  <list name="yamlInterpreters">
    <component-ref name="nullInterpreter"/>
    <component-ref name="dateTimeInterpreter"/>
    <component-ref name="lineSeparatorInterpreter"/>
    <component-ref name="compositeInterpreter"/>
  </list>

  <!-- YamlTestDataParser でtestDataParserを上書き。
       アクション実行時はこのdiConfigでリポジトリが再初期化され、同期送信の応答電文モックが
       testDataParserでテストデータを読むため、ここでYAMLリーダーを有効化する必要がある。
       unit-test.xml はこのファイルをimportするため、本定義でセットアップ/実行/検証の全フェーズに効く。 -->
  <component name="testDataParser" class="nablarch.test.core.reader.YamlTestDataParser">
    <property name="dbInfo" ref="dbInfo"/>
    <property name="interpreters" ref="yamlInterpreters"/>
  </component>

  <!-- 初期化が必要なコンポーネント -->
  <component name="initializer"
             class="nablarch.core.repository.initialization.BasicApplicationInitializer">
    <property name="initializeList">
      <list>
        <!-- 処理停止ハンドラ -->
        <component-ref name="processStopHandler"/>
        <!-- メッセージングプロバイダ -->
        <component-ref name="defaultMessagingProvider" />
      </list>
    </property>
  </component>

</component-configuration>
